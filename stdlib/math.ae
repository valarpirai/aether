//  Aether Standard Library - Math Utilities
// Mathematical functions and operations

// abs(n) - Absolute value
fn abs(n) {
    if (n < 0) {
        return -n
    }
    return n
}

// min(a, b) or min(array) - Minimum value
fn min(a, b) {
    // If b is null, treat a as an array
    if (type(b) == "null") {
        let array = a
        if (len(array) == 0) {
            return null
        }

        let minimum = array[0]
        for item in array {
            if (item < minimum) {
                minimum = item
            }
        }
        return minimum
    }

    // Two argument version
    if (a < b) {
        return a
    }
    return b
}

// max(a, b) or max(array) - Maximum value
fn max(a, b) {
    // If b is null, treat a as an array
    if (type(b) == "null") {
        let array = a
        if (len(array) == 0) {
            return null
        }

        let maximum = array[0]
        for item in array {
            if (item > maximum) {
                maximum = item
            }
        }
        return maximum
    }

    // Two argument version
    if (a > b) {
        return a
    }
    return b
}

// sum(array) - Sum of array elements
fn sum(array) {
    let total = 0
    for item in array {
        total = total + item
    }
    return total
}

// clamp(value, min_val, max_val) - Constrain value to range
fn clamp(value, min_val, max_val) {
    if (value < min_val) {
        return min_val
    }
    if (value > max_val) {
        return max_val
    }
    return value
}

// sign(n) - Sign of number (-1, 0, or 1)
fn sign(n) {
    if (n < 0) {
        return -1
    }
    if (n > 0) {
        return 1
    }
    return 0
}

// sqrt(n) - Square root using Newton's method
fn sqrt(n) {
    if (n < 0) {
        return null
    }
    if (n == 0) {
        return 0.0
    }
    let x = float(n)
    let guess = x / 2.0
    let i = 0
    while (i < 50) {
        let next = (guess + x / guess) / 2.0
        if (abs(next - guess) < 0.0000000001) {
            return next
        }
        guess = next
        i = i + 1
    }
    return guess
}

// pow(base, exp) - Integer exponentiation (exp must be non-negative int)
fn pow(base, exp) {
    if (exp == 0) {
        return 1
    }
    let result = 1
    let b = base
    let e = exp
    while (e > 0) {
        if (e % 2 == 1) {
            result = result * b
        }
        b = b * b
        e = e / 2
    }
    return result
}

// floor(n) - Round down to nearest integer
fn floor(n) {
    let i = int(n)
    if (float(i) > n) {
        return i - 1
    }
    return i
}

// ceil(n) - Round up to nearest integer
fn ceil(n) {
    let i = int(n)
    if (float(i) < n) {
        return i + 1
    }
    return i
}

// round(n) - Round to nearest integer
fn round(n) {
    return floor(n + 0.5)
}

// log(n, base) - Logarithm: log_base(n). Default base = e (natural log).
// Uses identity: log_b(n) = ln(n) / ln(b) via Newton approximation for ln.
fn log(n, base) {
    if (n <= 0) {
        return null
    }
    // Natural log via Halley's method: converges fast for n > 0
    let x = float(n)
    let guess = 0.0
    // Reduce x to [0.5, 1.5] for faster convergence
    let scale = 0
    while (x > 1.5) {
        x = x / 2.718281828459045
        scale = scale + 1
    }
    while (x < 0.5) {
        x = x * 2.718281828459045
        scale = scale - 1
    }
    // Halley iteration for ln(x) near 1
    let y = (x - 1.0) / (x + 1.0)
    let y2 = y * y
    let ln_x = 2.0 * (y + y2 * y / 3.0 + y2 * y2 * y / 5.0 + y2 * y2 * y2 * y / 7.0)
    let ln_n = ln_x + float(scale)
    if (type(base) == "null") {
        return ln_n
    }
    if (base == 10) {
        return ln_n / 2.302585092994046
    }
    if (base == 2) {
        return ln_n / 0.6931471805599453
    }
    return ln_n / log(base, null)
}

// gcd(a, b) - Greatest common divisor (Euclidean algorithm)
fn gcd(a, b) {
    a = abs(a)
    b = abs(b)
    while (b != 0) {
        let t = b
        b = a % b
        a = t
    }
    return a
}

// lcm(a, b) - Least common multiple
fn lcm(a, b) {
    if (a == 0 || b == 0) {
        return 0
    }
    return abs(a * b) / gcd(a, b)
}

// Math constants
let pi  = 3.141592653589793
let e   = 2.718281828459045
let tau = 6.283185307179586

// factorial(n) - n! for non-negative integer n
fn factorial(n) {
    if (n <= 1) {
        return 1
    }
    let result = 1
    let i = 2
    while (i <= n) {
        result = result * i
        i = i + 1
    }
    return result
}

// trunc(n) - Truncate toward zero (remove fractional part)
fn trunc(n) {
    return int(n)
}

// degrees(r) - Convert radians to degrees
fn degrees(r) {
    return float(r) * 180.0 / pi
}

// radians(d) - Convert degrees to radians
fn radians(d) {
    return float(d) * pi / 180.0
}

// hypot(x, y) - Euclidean distance sqrt(x² + y²)
fn hypot(x, y) {
    return sqrt(float(x) * float(x) + float(y) * float(y))
}

// exp(x) - e raised to the power x (Taylor series, 25 terms)
fn exp(x) {
    let result = 0.0
    let term = 1.0
    let i = 1
    while (i <= 25) {
        result = result + term
        term = term * float(x) / float(i)
        i = i + 1
    }
    return result + term
}

// sin(x) - Sine of x (radians), Taylor series with angle reduction
fn sin(x) {
    let two_pi = 6.283185307179586
    let xf = float(x)
    while (xf > two_pi) { xf = xf - two_pi }
    while (xf < -two_pi) { xf = xf + two_pi }
    let result = 0.0
    let term = xf
    let x2 = xf * xf
    let i = 1
    while (i <= 12) {
        result = result + term
        let denom = float(2 * i) * float(2 * i + 1)
        term = -term * x2 / denom
        i = i + 1
    }
    return result
}

// cos(x) - Cosine of x (radians), Taylor series with angle reduction
fn cos(x) {
    let two_pi = 6.283185307179586
    let xf = float(x)
    while (xf > two_pi) { xf = xf - two_pi }
    while (xf < -two_pi) { xf = xf + two_pi }
    let result = 0.0
    let term = 1.0
    let x2 = xf * xf
    let i = 1
    while (i <= 12) {
        result = result + term
        let denom = float(2 * i - 1) * float(2 * i)
        term = -term * x2 / denom
        i = i + 1
    }
    return result
}

// tan(x) - Tangent of x (radians)
fn tan(x) {
    return sin(x) / cos(x)
}
