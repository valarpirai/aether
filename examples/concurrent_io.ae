// Concurrent I/O demo — Phase 2: I/O thread pool
//
// Run with:  AETHER_IO_WORKERS=4 aether examples/concurrent_io.ae
// Or from code: set_workers(4) before any I/O calls

fn main() {
    println("=== Concurrent I/O Demo ===")
    println()

    // Enable I/O thread pool with 4 workers
    set_workers(4)

    // --- Async sleep ---
    println("1. Async sleep (non-blocking)...")
    let t1 = clock()
    let s1 = sleep(0.1)
    let s2 = sleep(0.1)
    // Both sleeps run in parallel — total time ~0.1s, not ~0.2s
    await s1
    await s2
    let t2 = clock()
    println("   Two 0.1s sleeps took:", t2 - t1, "seconds (parallelism!)")
    println()

    // --- Async file I/O ---
    println("2. Async file read...")
    let p = read_file("Cargo.toml")
    println("   read_file returned:", type(p))   // promise
    let content = await p
    let lines = content.split("\n")
    println("   Cargo.toml first line:", lines[0])
    println()

    // --- Promise.all: I/O promises resolve in parallel, not sequentially.
    //     Two 0.1s sleeps take ~0.1s total, not ~0.2s. ---
    println("3. Promise.all — parallel I/O...")
    let t3 = clock()
    let ps1 = sleep(0.1)
    let ps2 = sleep(0.1)
    let ps3 = sleep(0.1)
    await Promise.all([ps1, ps2, ps3])
    let t4 = clock()
    println("   Three 0.1s sleeps via Promise.all took:", t4 - t3, "seconds (expect ~0.1)")
    println()

    // --- Promise.all with file reads ---
    println("4. Promise.all — concurrent file reads...")
    let p1 = read_file("Cargo.toml")
    let p2 = read_file("README.md")
    let results = await Promise.all([p1, p2])
    println("   Cargo.toml size:", len(results[0]), "bytes")
    println("   README.md size:", len(results[1]), "bytes")
    println()

    // --- Promise.race: resolves with whichever promise finishes first ---
    println("5. Promise.race — first to finish wins...")
    let r1 = sleep(0.05)
    let r2 = sleep(0.2)
    let t5 = clock()
    await Promise.race([r1, r2])
    let t6 = clock()
    println("   race([50ms, 200ms]) took:", t6 - t5, "seconds (expect ~0.05)")
    println()

    // --- Promise.allSettled: collects all results, never throws ---
    println("6. Promise.allSettled — collects all results including errors...")
    let s1 = read_file("Cargo.toml")
    let s2 = read_file("does_not_exist.txt")
    let settled = await Promise.allSettled([s1, s2])
    println("   Cargo.toml:", settled[0]["status"])   // fulfilled
    println("   missing.txt:", settled[1]["status"])  // rejected
    println()

    // --- set_workers: change pool size at runtime ---
    println("7. Changing worker count at runtime...")
    set_workers(2)
    let p3 = sleep(0.05)
    await p3
    println("   Done with 2-worker pool.")
    println()

    // --- Async http (requires network) ---
    println("8. Async HTTP (requires network)...")
    try {
        let hp = http_get("https://httpbin.org/get")
        println("   http_get returned:", type(hp))   // promise
        let body = await hp
        let data = json_parse(body)
        println("   Response URL:", data["url"])
    } catch (e) {
        println("   Skipped (no network):", e)
    }
    println()

    println("Done.")
}
