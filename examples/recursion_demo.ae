// Recursion demo: countdown, factorial, fibonacci

fn countdown(n) {
    if (n <= 0) {
        return
    }
    println(n)
    countdown(n - 1)
}

fn factorial(n) {
    if (n <= 1) {
        return 1
    }
    return n * factorial(n - 1)
}

fn fib_recursive(n) {
    if (n <= 1) {
        return n
    }
    return fib_recursive(n - 1) + fib_recursive(n - 2)
}

fn fib_iterative(n) {
    if (n <= 1) {
        return n
    }
    let a = 0
    let b = 1
    let i = 2
    while (i <= n) {
        let temp = a + b
        a = b
        b = temp
        i += 1
    }
    return b
}

fn main() {
    println("=== Countdown ===")
    countdown(5)
    println()

    println("=== Factorial ===")
    println("1! =", factorial(1))
    println("5! =", factorial(5))
    println("10! =", factorial(10))
    println()

    println("=== Fibonacci (first 10) ===")
    let i = 0
    while (i < 10) {
        print(fib_iterative(i))
        print(" ")
        i += 1
    }
    println()
    println()

    let all_match = true
    let k = 0
    while (k < 10) {
        if (fib_recursive(k) != fib_iterative(k)) {
            all_match = false
        }
        k += 1
    }
    println("Recursive matches iterative:", all_match)
}
