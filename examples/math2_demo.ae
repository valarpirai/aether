fn main() {
    // Constants
    println("pi:", pi)
    println("e:", e)
    println("tau:", tau)

    // factorial
    println("10!:", factorial(10))

    // trunc — truncates toward zero
    println("trunc(3.9):", trunc(3.9))
    println("trunc(-3.9):", trunc(-3.9))

    // degrees / radians
    println("pi radians in degrees:", degrees(pi))
    println("90 degrees in radians:", radians(90.0))

    // hypot — Pythagorean theorem
    println("hypot(3, 4):", hypot(3, 4))

    // exp
    println("exp(1):", exp(1.0))
    println("exp(0):", exp(0.0))

    // sin / cos / tan
    println("sin(pi/6):", sin(pi / 6.0))
    println("cos(pi/3):", cos(pi / 3.0))
    println("tan(pi/4):", tan(pi / 4.0))

    // Pythagorean identity
    let angle = 1.2
    let identity = sin(angle) * sin(angle) + cos(angle) * cos(angle)
    println("sin²(1.2) + cos²(1.2) =", identity)

    // Circle area using pi
    fn circle_area(r) { return pi * r * r }
    println("area of circle r=5:", circle_area(5.0))
}
