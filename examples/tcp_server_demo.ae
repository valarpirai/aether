// TCP echo server — demonstrates all server lifecycle events
// Run: cargo run -- examples/tcp_server_demo.ae
// Test: echo "hello" | nc 127.0.0.1:8080
// Stop: Ctrl+C (graceful), Ctrl+C again (force)

let server = tcp_listen("127.0.0.1:8080")

server.on_listen(fn() {
    print("Listening on 127.0.0.1:8080")
})

server.on_connect(fn(conn) {
    print("Client connected")
    conn.write("Welcome to Aether TCP!\n")
})

// data is an array of byte values [104, 101, 108, 108, 111, ...]
// conn.write accepts a string or a byte array — both work
server.on_message(fn(conn, data) {
    print("Received " + str(len(data)) + " bytes")
    conn.write(data)
})

server.on_disconnect(fn(conn) {
    print("Client disconnected")
})

server.on_error(fn(err) {
    print("Error: " + err)
})

server.accept()
print("Server stopped.")
