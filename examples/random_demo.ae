fn main() {
    // --- random() ---
    println("=== random() ===")
    let r = random()
    println("random():", r)
    println("in [0, 1):", r >= 0.0 && r < 1.0)

    // --- rand_int(n) ---
    println("")
    println("=== rand_int(n) ===")
    let roll = rand_int(6) + 1
    println("dice roll (1-6):", roll)
    println("in range:", roll >= 1 && roll <= 6)

    let flip = rand_int(2)
    println("coin flip (0/1):", flip)

    // --- random element from an array ---
    println("")
    println("=== random choice ===")
    let colors = ["red", "green", "blue"]
    let picked = colors[rand_int(len(colors))]
    println("picked color:", picked)

    // --- distribution sanity check ---
    println("")
    println("=== distribution sanity check ===")
    let counts = [0, 0, 0]
    for i in range(0, 300) {
        let idx = rand_int(3)
        counts[idx] = counts[idx] + 1
    }
    println("counts across 300 rolls of rand_int(3):", counts)
}
