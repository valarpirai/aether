// V2 Plugin Demo - String and Array support

fn main() {
    let plugin = load_plugin("./target/release/libexample_plugin_v2.dylib")

    println("=== V2 Plugin Demo: Strings and Arrays ===")

    // String functions
    let name = "Alice"
    let greeting = plugin.greet(name)
    println("greet('Alice') =", greeting)

    let text = "hello"
    let upper = plugin.to_upper(text)
    println("to_upper('hello') =", upper)

    let repeated = plugin.repeat_string("ha", 3)
    println("repeat_string('ha', 3) =", repeated)

    // Array functions
    let nums = [5, 2, 8, 1, 9]
    println("\nOriginal array:", nums)

    let sorted = plugin.sort_array(nums)
    println("sort_array() =", sorted)

    let total = plugin.sum_array(nums)
    println("sum_array() =", total)

    let reversed = plugin.reverse_array(nums)
    println("reverse_array() =", reversed)

    // Dict functions
    let scores = {"alice": 10, "bob": 20, "carol": 30}
    println("\nScores:", scores)

    let total_score = plugin.sum_values(scores)
    println("sum_values() =", total_score)

    let bumped = plugin.increment_values(scores)
    println("increment_values() =", bumped)

    println("\n=== V2 protocol makes plugins powerful! ===")
}
