fn main() {
    // first / last
    let nums = [10, 20, 30, 40]
    println("first:", first(nums))
    println("last:", last(nums))
    println("first of empty:", first([]))

    // chunk
    println("chunk([1..8], 3):", chunk([1,2,3,4,5,6,7,8], 3))

    // partition
    fn is_even(x) { return x % 2 == 0 }
    let parts = partition([1,2,3,4,5,6], is_even)
    println("evens:", parts[0])
    println("odds:", parts[1])

    // zip_longest
    let zipped = zip_longest(["a","b","c"], [1, 2], "?")
    println("zip_longest:", zipped)

    // uniq_by — dedupe all, not just consecutive
    fn identity(x) { return x }
    println("uniq_by:", uniq_by([1,2,1,3,2,4,3], identity))

    fn domain(email) {
        let parts = email.split("@")
        return parts[1]
    }
    let emails = ["a@gmail.com", "b@yahoo.com", "c@gmail.com", "d@hotmail.com"]
    println("one per domain:", uniq_by(emails, domain))
}
